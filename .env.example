# Local Convex CLI configuration.
# These are written automatically by `npx convex dev` into .env.local —
# you normally don't need to create this file by hand.
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_URL=https://your-deployment.convex.cloud

# ─────────────────────────────────────────────────────────────────────
# The variables below live on the Convex DEPLOYMENT, not in this file.
# Set them with `npx convex env set <NAME> <value>`:
#
#   AUTH_GOOGLE_ID       Google OAuth client ID (user sign-in)
#   AUTH_GOOGLE_SECRET   Google OAuth client secret
#   SITE_URL             URL of the deployed auth-app (also used by Convex Auth)
#   AUTH_APP_URL         Optional override if the auth app is hosted elsewhere
#   JWT_PRIVATE_KEY      Generated by `npx @convex-dev/auth`
#   JWKS                 Generated by `npx @convex-dev/auth`
#
# CONVEX_SITE_URL (the .convex.site URL) is provided automatically by Convex.
# ─────────────────────────────────────────────────────────────────────
