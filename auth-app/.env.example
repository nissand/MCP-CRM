# Convex client URL (WebSocket API) — from `npx convex dev` in the repo root
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Convex HTTP actions URL — same deployment, .convex.site suffix.
# Used for the OAuth code endpoint and shown in the MCP connection snippets.
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
